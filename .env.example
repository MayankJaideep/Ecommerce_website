# ---- Database ----
DATABASE_URL="file:./dev.db"

# ---- Admin (REQUIRED) ----
# Password the shop owner uses at /admin/login
ADMIN_PASSWORD="change-me-to-a-long-password"
# Random 32+ char secret for signing admin sessions: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="replace-with-64-hex-chars"

# ---- Brand / payment (shown to customers) ----
NEXT_PUBLIC_UPI_ID="yourname@okhdfcbank"
NEXT_PUBLIC_UPI_PAYEE_NAME="Amma's Hurlikattu"
# WhatsApp number with country code, digits only
NEXT_PUBLIC_WHATSAPP_NUMBER="919902611171"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Payment screenshot storage ----
# "local" stores files in ./storage/uploads (private, never publicly served).
# Use "s3" in production (AWS S3, Cloudflare R2, Backblaze B2, MinIO...).
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""          # e.g. https://<account>.r2.cloudflarestorage.com (leave blank for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
